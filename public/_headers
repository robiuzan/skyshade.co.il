# Cloudflare Pages response headers. This file ships in out/ from public/ and is THE
# place headers are configured — there is no server and no .htaccess. Spec: the security
# audit of 2026-08-17 (audit-roadmap-full.md §6.2).
#
# CSP is REPORT-ONLY on purpose: run it 2-3 weeks, watch browser consoles / a report
# endpoint for violations from GTM's real tag set, then rename to Content-Security-Policy.
# Whoever edits the GTM container owns this allowlist — a new tag (Ads, Meta pixel) will be
# silently blocked once enforced. 'unsafe-inline' is a deliberate concession to the static
# export + GTM bootstrap; strict nonces would need a Worker.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://imgquarry.com https://www.googletagmanager.com https://*.google-analytics.com; font-src 'self'; connect-src 'self' https://api.web3forms.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://stats.g.doubleclick.net; frame-src https://www.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self' https://api.web3forms.com; upgrade-insecure-requests

# Content-hashed build assets: cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# RSC payloads (/page/index.txt) must not be indexed — but keep them, the router needs them.
/*.txt
  X-Robots-Tag: noindex

/robots.txt
  ! X-Robots-Tag
